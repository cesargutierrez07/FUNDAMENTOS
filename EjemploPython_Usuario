# REGISTRAR PERSONA
def registrar_persona():
    print("\n--- REGISTRAR PERSONA ---")

    nombre = input("Nombre: ")
    fecha = input("Fecha de nacimiento (DD/MM/AAAA): ")

    while not validar_fecha(fecha):
        print("Fecha incorrecta. Ingrese una fecha real.")
        fecha = input("Fecha de nacimiento (DD/MM/AAAA): ")

    direccion = input("Dirección: ")
    telefono = input("Teléfono: ")

    celular = input("Celular (máx. 8 dígitos): ")
    while not validar_celular(celular):
        print("Celular incorrecto. Debe contener solo números y máximo 8 dígitos.")
        celular = input("Celular (máx. 8 dígitos): ")

    pagina_web = input("Página web (debe empezar con 'www'): ")
    while not validar_pagina_web(pagina_web):
        print("Página web incorrecta. Debe empezar por 'www'.")
        pagina_web = input("Página web (debe empezar con 'www'): ")

    persona = [nombre, fecha, direccion, telefono, celular, pagina_web]
    personas.append(persona)

    print("Persona registrada correctamente.")


# LISTAR PERSONAS
def listar_personas():
    print("\n--- LISTA DE PERSONAS ---")

    if len(personas) == 0:
        print("No existen personas registradas.")
    else:
        for i in range(len(personas)):
            print("\nPersona Nro:", i + 1)
            print("Nombre:", personas[i][0])
            print("Fecha de nacimiento:", personas[i][1])
            print("Dirección:", personas[i][2])
            print("Teléfono:", personas[i][3])
            print("Celular:", personas[i][4])
            print("Página web:", personas[i][5])


# BORRAR PERSONA
def borrar_persona():
    print("\n--- BORRAR PERSONA ---")
    nombre = input("Ingrese el nombre de la persona a eliminar: ")

    for p in personas:
        if p[0] == nombre:
            personas.remove(p)
            print("Persona eliminada correctamente.")
            return

    print("Persona no encontrada.")


# MODIFICAR PERSONA
def modificar_persona():
    print("\n--- MODIFICAR PERSONA ---")
    nombre = input("Ingrese el nombre de la persona a modificar: ")

    for p in personas:
        if p[0] == nombre:
            p[0] = input("Nuevo nombre: ")

            fecha = input("Nueva fecha de nacimiento (DD/MM/AAAA): ")
            while not validar_fecha(fecha):
                print("Fecha incorrecta. Ingrese una fecha real.")
                fecha = input("Nueva fecha de nacimiento (DD/MM/AAAA): ")
            p[1] = fecha

            p[2] = input("Nueva dirección: ")
            p[3] = input("Nuevo teléfono: ")

            celular = input("Nuevo celular (máx. 8 dígitos): ")
            while not validar_celular(celular):
                print("Celular incorrecto. Debe contener solo números y máximo 8 dígitos.")
                celular = input("Nuevo celular (máx. 8 dígitos): ")
            p[4] = celular

            pagina_web = input("Nueva página web (debe empezar con 'www'): ")
            while not validar_pagina_web(pagina_web):
                print("Página web incorrecta. Debe empezar por 'www'.")
                pagina_web = input("Nueva página web (debe empezar con 'www'): ")
            p[5] = pagina_web

            print("Persona modificada correctamente.")
            return

    print("Persona no encontrada.")


# MENU DE PERSONAS
