#include <iostream>

using namespace std;

int main() {
    int N;
    int suma = 0;
    
    cout << "Ingrese un número entero positivo: ";
    cin >> N;

    for (int i = 1; i <= N; i++) {
        suma += i;
    }

    cout << "La suma de los enteros de 1 a " << N << " es: " << suma << endl;

    return 0;
}
